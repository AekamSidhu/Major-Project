# OpenMeet development environment variables.
#
# API keys are normally stored in the OS credential store from the app
# (Settings → AI providers). Environment variables are a development fallback
# and are read when no key is stored in the credential store.
# Copy to `.env` (ignored by git) or export them in your shell. Never commit keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Key for an OpenAI-compatible server, if it requires one.
OPENAI_COMPATIBLE_API_KEY=

# Ollama (local models). Configure the URL in Settings → AI providers; this is
# the default it uses.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local AI sidecar (faster-whisper + fastembed, see local-ai/).
# Directory containing server.py and .venv (defaults to the repository's local-ai/).
OPENMEET_LOCAL_AI_DIR=
OPENMEET_LOCAL_AI_PORT=8765
# whisper device: auto | cpu | cuda (auto falls back to CPU without CUDA runtime)
OPENMEET_WHISPER_DEVICE=auto
OPENMEET_WHISPER_MODEL=base.en
OPENMEET_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional bearer token required by the sidecar's /v1 endpoints.
OPENMEET_LOCAL_AI_TOKEN=

# Log filter (tracing EnvFilter syntax), e.g. "info" or "openmeet_engine=debug".
# Logs never contain transcript text, prompts, model output or keys.
OPENMEET_LOG=
