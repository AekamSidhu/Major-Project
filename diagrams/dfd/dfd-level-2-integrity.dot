// DFD Level 2 for process 11.0 (Assess answer integrity): two independent
// cheating signals, AI-echo answer analysis (text + delivery) and
// reading-gaze detection (video), fused into one flag with evidence. Flags
// are signals for the interviewer, never automatic verdicts.
digraph dfd2_integrity {
  graph [rankdir=LR, fontname="Segoe UI", fontsize=16, labelloc=t, nodesep=0.45, ranksep=0.85,
         label="DFD Level 2 — 11.0 Assess answer integrity", pad=0.3];
  node  [fontname="Segoe UI", fontsize=11];
  edge  [fontname="Segoe UI", fontsize=9, color="#3E4756", fontcolor="#3E4756"];

  node [shape=box, style=filled, fillcolor="#FFFFFF", color="#3E4756"];
  p2   [label="2.0 Segment &\ntranscribe", style="filled,dashed"];
  p3   [label="3.0 Analyse\nconversation", style="filled,dashed"];
  p4   [label="4.0 Capture &\ninterpret screen", style="filled,dashed"];
  p7   [label="7.0 Present UI", style="filled,dashed"];
  p9   [label="9.0 Persist", style="filled,dashed"];
  llm  [label="Language model\n(local by default)"];
  emb  [label="Embedding provider\n(built-in, local or cloud)"];
  gaze [label="Gaze model\n(MediaPipe Face Mesh +\niris, local AI sidecar)"];

  node [shape=circle, style=filled, fillcolor="#E6E9FB", color="#4F5BD5", penwidth=1.6, width=1.1];
  p111 [label="11.1\nBuild\nspeaker\nbaseline"];
  p112 [label="11.2\nExtract\ndelivery\nfeatures"];
  p113 [label="11.3\nGenerate\nreference\nanswers"];
  p114 [label="11.4\nCompute\necho score"];
  p115 [label="11.5\nTrack\ngaze"];
  p116 [label="11.6\nDetect\nreading\npattern"];
  p117 [label="11.7\nFuse signals\n& flag"];

  node [shape=none, width=0, style="", penwidth=1];
  d2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#EEF7F1">D2</TD><TD SIDES="TB" BGCOLOR="#EEF7F1">Settings (thresholds, gaze on / off)</TD></TR></TABLE>>];
  d3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#EEF7F1">D3</TD><TD SIDES="TB" BGCOLOR="#EEF7F1">Conversation memory (baseline, flags)</TD></TR></TABLE>>];

  // AI-echo: delivery
  p2 -> p111   [label="candidate small-talk\nsegments (first minutes)"];
  p111 -> d3   [label="baseline: speech rate,\npause and filler profile"];
  p2 -> p112   [label="answer segments\n+ word timestamps"];
  p3 -> p112   [label="question end time"];
  d3 -> p112   [label="baseline"];
  p112 -> p117 [label="delivery anomaly\n(start delay, rate evenness,\nfillers, mid-sentence pauses)"];

  // AI-echo: content
  p3 -> p113   [label="interviewer question"];
  p113 -> llm  [dir=both, label="reference-answer prompt /\n3–4 sampled answers"];
  p113 -> p114 [label="reference answers"];
  p3 -> p114   [label="candidate answer text"];
  p114 -> emb  [dir=both, label="texts / vectors"];
  p114 -> p117 [label="echo score\n(max cosine to references)"];

  // Reading gaze
  p4 -> p115   [label="candidate video tile\n(cropped, 10 fps)"];
  p115 -> gaze [dir=both, label="face crop /\niris + eye landmarks"];
  p115 -> p116 [label="gaze direction\ntime series"];
  p3 -> p116   [label="answer start / end"];
  p116 -> p117 [label="reading score\n(line sweeps, off-screen\nfixation while answering)"];

  // Fusion
  d2 -> p117   [label="thresholds,\nsignal weights"];
  p117 -> d3   [label="integrity flag"];
  p117 -> p7   [label="flag + evidence\n(timestamps, scores)"];
  p117 -> p9   [label="integrity flag"];
}
