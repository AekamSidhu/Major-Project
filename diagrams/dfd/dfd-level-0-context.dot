// DFD Level 0 (context diagram): OpenMeet as a single process and the
// external entities it exchanges data with. Yourdon–DeMarco notation:
// rectangle = external entity, circle = process.
digraph dfd0 {
  graph [rankdir=LR, fontname="Segoe UI", fontsize=16, labelloc=t, nodesep=0.7, ranksep=1.3,
         label="OpenMeet — DFD Level 0 (Context Diagram)", pad=0.3];
  node  [fontname="Segoe UI", fontsize=12];
  edge  [fontname="Segoe UI", fontsize=10, color="#3E4756", fontcolor="#3E4756"];

  user   [shape=box, style="filled", fillcolor="#FFFFFF", label="User\n(candidate or interviewer)"];
  remote [shape=box, style="filled", fillcolor="#FFFFFF", label="Other meeting\nparticipants"];
  os     [shape=box, style="filled", fillcolor="#FFFFFF", label="Operating system\n(audio devices, displays,\nOCR, credential store,\nwindow manager)"];
  local  [shape=box, style="filled", fillcolor="#FFFFFF", label="Local AI services\n(Ollama, OpenMeet\nlocal AI sidecar)"];
  cloud  [shape=box, style="filled,dashed", fillcolor="#FFFFFF", label="Cloud AI providers\n(OpenAI, Anthropic,\nOpenAI-compatible)\noptional"];
  files  [shape=box, style="filled", fillcolor="#FFFFFF", label="File system\n(exports, app data)"];

  sys [shape=circle, style="filled", fillcolor="#E6E9FB", color="#4F5BD5", penwidth=2, label="0\nOpenMeet"];

  user -> sys   [label="voice (microphone), hotkeys,\nAsk prompts, settings, profile,\nAPI keys, start / stop / pause"];
  sys  -> user  [label="overlay suggestions,\nfollow-ups, transcript,\nsummaries, history, status"];
  remote -> sys [label="speech (via system audio),\nshared screen content"];
  os -> sys     [label="audio frames, screen frames,\nOCR text, stored API keys,\ndisplay / window info"];
  sys -> os     [label="capture requests, keychain writes,\ncapture-exclusion flag,\nhotkey registration"];
  sys -> local  [label="audio clips, prompts with\nmeeting context, text to embed"];
  local -> sys  [label="transcripts, streamed answers,\nembeddings"];
  sys -> cloud  [label="audio / prompts / frames\n(only if selected and\nlocal-only mode is off)", style=dashed];
  cloud -> sys  [label="transcripts, streamed answers,\nembeddings, frame descriptions", style=dashed];
  sys -> files  [label="exported Markdown / text / JSON,\nmeeting database"];
  files -> sys  [label="stored meetings,\nsettings"];
}
