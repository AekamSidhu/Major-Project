' Shared look for every PlantUML diagram in this folder.
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam padding 2
skinparam ArrowColor #3E4756
skinparam ArrowFontSize 11
skinparam ArrowFontColor #3E4756
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ClassBackgroundColor #F6F7FD
skinparam ClassBorderColor #4F5BD5
skinparam ClassHeaderBackgroundColor #E6E9FB
skinparam ClassAttributeIconSize 0
skinparam StereotypeCBackgroundColor #C8CDF7
skinparam InterfaceBackgroundColor #F6F7FD
skinparam InterfaceBorderColor #4F5BD5
skinparam ComponentBackgroundColor #F6F7FD
skinparam ComponentBorderColor #4F5BD5
skinparam PackageBackgroundColor #FBFBFD
skinparam PackageBorderColor #8A93B5
skinparam NodeBackgroundColor #F3F5F9
skinparam NodeBorderColor #5B6478
skinparam DatabaseBackgroundColor #EEF7F1
skinparam DatabaseBorderColor #2E8B57
skinparam ActorBorderColor #3E4756
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor #F6F7FD
skinparam UsecaseBorderColor #4F5BD5
skinparam ActivityBackgroundColor #F6F7FD
skinparam ActivityBorderColor #4F5BD5
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam ActivityDiamondBorderColor #C9A227
skinparam StateBackgroundColor #F6F7FD
skinparam StateBorderColor #4F5BD5
skinparam SequenceLifeLineBorderColor #8A93B5
skinparam SequenceParticipantBackgroundColor #F6F7FD
skinparam SequenceParticipantBorderColor #4F5BD5
skinparam SequenceGroupBackgroundColor #EEF0FA
skinparam SequenceBoxBackgroundColor #FBFBFD
skinparam ObjectBackgroundColor #F6F7FD
skinparam ObjectBorderColor #4F5BD5
skinparam EntityBackgroundColor #F6F7FD
skinparam EntityBorderColor #4F5BD5
