// Derived from: Cargo.toml ([workspace.dependencies]), crates/*/Cargo.toml, src-tauri/Cargo.toml,
// Cargo.lock (resolved versions), package.json, local-ai/requirements.txt.
// Only [dependencies] are drawn (plus the one workspace dev-dependency engine -> providers);
// ubiquitous utility crates are summarised in the note instead of drawn as edges.
digraph external_dependencies {
  graph [rankdir=LR, fontname="Segoe UI", fontsize=12, nodesep=0.22, ranksep=0.9,
         bgcolor="#FFFFFF", pad=0.3, compound=true, newrank=true,
         label=<<B>OpenMeet crate dependency graph with key external crates and packages</B>>,
         labelloc=t, fontsize=16];
  node  [fontname="Segoe UI", fontsize=11, shape=box, style="rounded,filled",
         fillcolor="#FFFFFF", color="#8A93B5", fontcolor="#1F2430", margin="0.12,0.05"];
  edge  [fontname="Segoe UI", fontsize=9, color="#3E4756", fontcolor="#3E4756", arrowsize=0.7];

  subgraph cluster_ws {
    label=<<B>Rust workspace</B>>; style="rounded,filled"; fillcolor="#F6F7FD"; color="#4F5BD5";
    node [fillcolor="#E6E9FB", color="#4F5BD5", penwidth=1.4];
    app       [label=<<B>openmeet</B><BR/><FONT POINT-SIZE="9">src-tauri (openmeet_lib + bin)</FONT>>];
    engine    [label=<<B>openmeet-engine</B>>];
    providers [label=<<B>openmeet-providers</B>>];
    platform  [label=<<B>openmeet-platform</B>>];
    store     [label=<<B>openmeet-store</B>>];
    intel     [label=<<B>openmeet-intel</B>>];
    core      [label=<<B>openmeet-core</B>>];
  }

  // ---- workspace path dependencies ----
  edge [color="#4F5BD5", penwidth=1.3];
  app -> {engine providers platform store intel core};
  engine -> {intel core};
  engine -> providers [style=dashed, label="dev-dependency"];
  intel -> core; providers -> core; platform -> core; store -> core;

  // ---- external crates ----
  edge [color="#3E4756", penwidth=1.0];

  subgraph cluster_desktop {
    label="Desktop shell"; style="rounded,dashed"; color="#8A93B5"; fontcolor="#3E4756";
    tauri    [label=<tauri 2.12 <FONT POINT-SIZE="9">(tray-icon, image-png, macos-private-api)</FONT>>];
    plugins  [label=<tauri-plugin-global-shortcut / -dialog /<BR/>-clipboard-manager / -autostart /<BR/>-single-instance / -opener / -notification>];
    tbuild   [label=<tauri-build 2.7 <FONT POINT-SIZE="9">[build-dependency]</FONT>>];
    keyring  [label=<keyring 4.2 <FONT POINT-SIZE="9">(OS credential store)</FONT>>];
  }
  app -> {tauri plugins keyring};
  app -> tbuild [style=dashed];

  subgraph cluster_async {
    label="Async runtime / HTTP"; style="rounded,dashed"; color="#8A93B5"; fontcolor="#3E4756";
    tokio   [label="tokio 1.53"];
    reqwest [label=<reqwest 0.13 <FONT POINT-SIZE="9">(rustls, http2, multipart, system-proxy)</FONT>>];
  }
  {app engine intel providers core} -> tokio;
  providers -> reqwest;

  subgraph cluster_storage {
    label="Storage"; style="rounded,dashed"; color="#2E8B57"; fontcolor="#2E8B57";
    rusqlite [label=<rusqlite 0.40 <FONT POINT-SIZE="9">(bundled SQLite)</FONT>>, fillcolor="#EEF7F1", color="#2E8B57"];
  }
  store -> rusqlite;

  subgraph cluster_os {
    label="OS capture / integration"; style="rounded,dashed"; color="#8A93B5"; fontcolor="#3E4756";
    cpal    [label=<cpal 0.18 <FONT POINT-SIZE="9">(audio; pulseaudio feature on Linux)</FONT>>];
    xcap    [label=<xcap 0.9 <FONT POINT-SIZE="9">(screen / window capture)</FONT>>];
    image   [label=<image 0.25 <FONT POINT-SIZE="9">(png only)</FONT>>];
    sysinfo [label=<sysinfo 0.39 <FONT POINT-SIZE="9">(system)</FONT>>];
    rwh     [label="raw-window-handle 0.6"];
    windows [label=<windows 0.62 <FONT POINT-SIZE="9">[cfg(windows)]: Media_Ocr, Win32_UI_*, ...</FONT>>];
    objc2   [label=<objc2 0.6 / objc2-app-kit 0.3 /<BR/>objc2-core-graphics 0.3 / dispatch2 0.3<BR/><FONT POINT-SIZE="9">[cfg(target_os = "macos")]</FONT>>];
  }
  platform -> {cpal xcap image sysinfo rwh windows objc2};
  app -> rwh;

  subgraph cluster_text {
    label="Types / text"; style="rounded,dashed"; color="#8A93B5"; fontcolor="#3E4756";
    tsrs   [label=<ts-rs 12 <FONT POINT-SIZE="9">(TypeScript bindings)</FONT>>];
    uuid   [label=<uuid 1.26 <FONT POINT-SIZE="9">(v4, v7)</FONT>>];
    regex  [label="regex 1"];
    base64 [label="base64 0.23"];
  }
  core -> {tsrs uuid};
  intel -> {regex base64};
  providers -> base64;

  note [shape=note, style=filled, fillcolor="#FFF8E1", color="#C9A227", fontsize=10,
        label=<Utility crates not drawn as edges (from each Cargo.toml):<BR ALIGN="LEFT"/>serde + serde_json: all crates except openmeet-platform<BR ALIGN="LEFT"/>tracing: all crates except openmeet-core<BR ALIGN="LEFT"/>parking_lot: all crates except openmeet-providers<BR ALIGN="LEFT"/>thiserror: core, platform, app<BR ALIGN="LEFT"/>futures + tokio-util: core, engine, intel, providers, app<BR ALIGN="LEFT"/>async-trait: core, engine, intel, providers<BR ALIGN="LEFT"/>tracing-subscriber: app (store: dev only)<BR ALIGN="LEFT"/>>];

  // ---- frontend and sidecar packages ----
  subgraph cluster_fe {
    label=<<B>Frontend (package.json)</B>>; style="rounded,filled"; fillcolor="#F6F7FD"; color="#4F5BD5";
    fe [label=<<B>src/</B> (React + Vite)>, fillcolor="#E6E9FB", color="#4F5BD5", penwidth=1.4];
    react   [label="react / react-dom 19"];
    zustand [label="zustand 5"];
    tapi    [label=<@tauri-apps/api 2 <FONT POINT-SIZE="9">(core invoke, event listen, window)</FONT>>];
    tclip   [label="@tauri-apps/plugin-clipboard-manager 2"];
  }
  fe -> {react zustand tapi tclip};

  subgraph cluster_py {
    label=<<B>local-ai sidecar (requirements.txt)</B>>; style="rounded,filled"; fillcolor="#F6F7FD"; color="#4F5BD5";
    py [label=<<B>server.py</B>>, fillcolor="#E6E9FB", color="#4F5BD5", penwidth=1.4];
    fastapi [label="fastapi + uvicorn + python-multipart"];
    whisper [label="faster-whisper"];
    fembed  [label="fastembed"];
    numpy   [label="numpy"];
  }
  py -> {fastapi whisper fembed numpy};

  // keep the side clusters stacked under the workspace
  edge [style=invis];
  core -> note;
}
