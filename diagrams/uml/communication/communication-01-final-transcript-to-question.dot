// Derived from: crates/openmeet-engine/src/transcription.rs (VadSession::transcribe_final, Shared::complete),
// crates/openmeet-engine/src/conversation.rs (spawn_conversation, on_transcription_event, handle_final, run_actions),
// crates/openmeet-engine/src/metrics.rs (record_latency), crates/openmeet-engine/src/engine.rs (Engine::persist, Engine::emit),
// crates/openmeet-engine/src/embedder.rs (EmbedJob, spawn_embedder).
// UML communication diagram drawn with Graphviz (PlantUML has no native notation):
// objects are boxes with an underlined "name : Type", each link carries its numbered
// messages, and the open arrowhead on the link shows the direction of those messages.
digraph communication01 {
  graph [fontname="Segoe UI", fontsize=16, labelloc=t, nodesep=0.5, ranksep=0.6, pad=0.3, bgcolor="#FFFFFF",
         label=<<B>Communication 01: final transcript segment -&gt; question detected (Candidate mode)</B>>];
  node  [fontname="Segoe UI", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F6F7FD", color="#4F5BD5", margin="0.15,0.08"];
  edge  [fontname="Segoe UI", fontsize=10, color="#3E4756", fontcolor="#3E4756", arrowhead=vee, arrowsize=0.7];

  vad    [label=<<U>session : VadSession</U>>];
  tr     [label=<<U>transcriber : dyn Transcriber</U>>, fillcolor="#FFFFFF"];
  loop   [label=<<U>conversation loop</U><BR/><FONT POINT-SIZE="9">tokio task from spawn_conversation</FONT>>];
  engine [label=<<U>engine : Engine</U>>, fillcolor="#E6E9FB"];
  rt     [label=<<U>rt : MeetingRuntime</U>>];
  intel  [label=<<U>openmeet_intel</U><BR/><FONT POINT-SIZE="9">claims, detect</FONT>>];
  lat    [label=<<U>latency : LatencyTracker</U>>];
  per    [label=<<U>persist : Persister</U>>, fillcolor="#EEF7F1"];
  emb    [label=<<U>embedder task</U><BR/><FONT POINT-SIZE="9">spawn_embedder</FONT>>];
  sink   [label=<<U>sink : TauriSink</U>>];
  assist [label=<<U>assist module</U><BR/><FONT POINT-SIZE="9">see communication 02</FONT>>];

  vad -> tr     [label="1: transcribe(request, cancel)"];
  vad -> loop   [label="2: events.send(TranscriptionEvent::Draft(d))\l    (Shared::complete, in utterance order)\l"];
  loop -> engine [label="3: on_transcription_event(meeting_id, Draft(d))\l    -> handle_final(meeting_id, d, true)\l"];
  engine -> rt  [label="3.1: add_final(segment)\l3.2: memory.add(MemoryItem Segment)\l3.5: topics.observe(&segment)\l3.7: questions.push(q)\l3.8: memory.add(MemoryItem Question)\l"];
  engine -> intel [label="3.3: extract_claims(&segment)\l3.4: extract_action_items(&segment)\l3.6: detect(&DetectionInput)\l"];
  engine -> lat [label="3.9: record_latency(AudioToTranscript)\l3.10: record_latency(TranscriptToDetection)\l"];
  engine -> per [label="3.11: persist(store, PersistOp::Segment)\l3.12: persist(store, PersistOp::Question)\l"];
  engine -> sink [label="3.13: emit(TranscriptFinal)\l3.14: emit(QuestionDetected)\l"];
  engine -> emb [label="3.15: embed_tx.send(EmbedJob)"];
  engine -> assist [label="3.16: run_actions([Action::Answer(q)])\l    -> answer_question(q, style)\l"];

  note [shape=note, style=filled, fillcolor="#FFF8E1", color="#C9A227", fontsize=10,
        label="The question is accepted when confidence >= assistant.detection_threshold.\lAction::Answer is queued only when the meeting is Active, mode == Candidate,\lq.requires_response and settings.assistant.auto_answer are true.\lPersists / events for claims, action items and topics are omitted here.\l"];
  assist -> note [style=dashed, arrowhead=none, color="#C9A227"];
}
