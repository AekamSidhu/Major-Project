@startuml
!include ../_style.iuml
' Derived from: crates/openmeet-store/migrations/0001_initial.sql (schema version 1) and
' crates/openmeet-store/migrations/0002_integrity_flags.sql (schema version 2, the integrity_flags table),
' and crates/openmeet-store/src/migrations.rs (MIGRATIONS, SCHEMA_VERSION = 2, PRAGMA user_version).
' Every table, column, type, default, key and FOREIGN KEY below is copied from the SQL.
title OpenMeet SQLite schema v2 - physical ER diagram (crow's foot)

hide circle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70
skinparam EntityFontSize 11
skinparam ClassAttributeFontSize 11

entity "meetings" as meetings {
  * id : TEXT <<PK>>
  --
  * title : TEXT
  * mode : TEXT
  * state : TEXT
  * started_at : INTEGER
    ended_at : INTEGER
  * persisted : INTEGER = 1
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "participants" as participants {
  * meeting_id : TEXT <<PK, FK>>
  * position : INTEGER <<PK>>
  --
  * id : TEXT
  * role : TEXT
  * label : TEXT
  * updated_at : INTEGER
}

entity "transcript_segments" as transcript_segments {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * utterance_id : TEXT
    speaker_id : TEXT
  * speaker_role : TEXT
  * source : TEXT
  * start_time : INTEGER
  * end_time : INTEGER
  * text : TEXT
  * is_final : INTEGER
    confidence : REAL
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "questions" as questions {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * question : TEXT
  * parts : TEXT = '[]'
  * segment_ids : TEXT = '[]'
  * is_question : INTEGER
  * confidence : REAL
  * category : TEXT
    speaker_id : TEXT
  * speaker_role : TEXT
  * requires_response : INTEGER
  * method : TEXT
    supersedes : TEXT
  * detected_at : INTEGER
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "answers" as answers {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
    question_id : TEXT
  * speaker_role : TEXT
  * text : TEXT
  * segment_ids : TEXT = '[]'
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "ai_suggestions" as ai_suggestions {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * kind : TEXT
    question_id : TEXT
    question_text : TEXT
    category : TEXT
    style : TEXT
    parent_id : TEXT
  * prompt_id : TEXT
  * prompt_version : INTEGER
  * content : TEXT
  * followups : TEXT = '[]'
  * provider : TEXT
  * model : TEXT
  * pinned : INTEGER = 0
  * created_at : INTEGER
    completed_at : INTEGER
  * updated_at : INTEGER
}

entity "topics" as topics {
  * meeting_id : TEXT <<PK, FK>>
  * position : INTEGER <<PK>>
  --
  * id : TEXT
  * name : TEXT
  * status : TEXT
  * mentions : INTEGER = 0
    first_mentioned_at : INTEGER
    last_mentioned_at : INTEGER
  * planned : INTEGER = 0
    summary : TEXT
  * updated_at : INTEGER
}

entity "claims" as claims {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * text : TEXT
  * kind : TEXT
    segment_id : TEXT
  * speaker_role : TEXT
  * source : TEXT
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "screen_observations" as screen_observations {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * observed_at : INTEGER
  * source : TEXT
    application : TEXT
    title : TEXT
  * description : TEXT
    visible_text : TEXT
  * entities : TEXT = '[]'
    content_type : TEXT
    frame_hash : TEXT
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "action_items" as action_items {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
  * text : TEXT
    owner : TEXT
    source_segment_id : TEXT
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "meeting_summaries" as meeting_summaries {
  * meeting_id : TEXT <<PK, FK>>
  --
  * overview : TEXT
  * key_topics : TEXT = '[]'
  * questions_asked : TEXT = '[]'
  * answers : TEXT = '[]'
  * decisions : TEXT = '[]'
  * action_items : TEXT = '[]'
  * open_questions : TEXT = '[]'
  * technical_topics : TEXT = '[]'
  * follow_up_suggestions : TEXT = '[]'
    interviewer : TEXT
  * markdown : TEXT
  * generated_at : INTEGER
  * generated_by : TEXT
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "embeddings" as embeddings {
    id : INTEGER <<PK>> (rowid)
  --
  * meeting_id : TEXT <<FK, UK1>>
  * item_id : TEXT <<UK1>>
  * kind : TEXT <<UK1>>
  * model : TEXT <<UK1>>
  * dims : INTEGER
  * vector : BLOB
  * created_at : INTEGER
  * updated_at : INTEGER
}

entity "integrity_flags" as integrity_flags {
  * id : TEXT <<PK>>
  --
  * meeting_id : TEXT <<FK>>
    question_id : TEXT
    question_text : TEXT
  * answer_start_ms : INTEGER
  * answer_end_ms : INTEGER
  * answer_words : INTEGER
  * level : TEXT
  * elevated : TEXT = '[]'
  * headline : TEXT
  * signals : TEXT = '[]'
  * revision : INTEGER
  * spec_version : INTEGER
  * created_at : INTEGER
  * checked_at : INTEGER
  * updated_at : INTEGER
}

package "Not meeting data (kept by delete_all_meeting_data and retention)" {
  entity "privacy_rules" as privacy_rules {
    * id : TEXT <<PK>>
    --
    * rule_type : TEXT
    * value : TEXT
    * rule_action : TEXT
    * created_at : INTEGER
    * updated_at : INTEGER
  }

  entity "settings" as settings {
    * name : TEXT <<PK>>
    --
    * value : TEXT
    * updated_at : INTEGER
  }
}

' --- Foreign keys: every one is meeting_id REFERENCES meetings (id) ON DELETE CASCADE ---
meetings ||-down-o{ participants
meetings ||-down-o{ transcript_segments
meetings ||-down-o{ questions
meetings ||-down-o{ answers
meetings ||-down-o{ ai_suggestions
meetings ||-down-o{ topics
meetings ||-up-o{ claims
meetings ||-up-o{ screen_observations
meetings ||-up-o{ action_items
meetings ||-up-o| meeting_summaries
meetings ||-up-o{ embeddings
meetings ||-up-o{ integrity_flags

privacy_rules -[hidden]down- settings

legend bottom left
  <b>Notation</b>
  ~* = NOT NULL;  <<PK>> primary key;  <<FK>> = meeting_id REFERENCES meetings (id) ON DELETE CASCADE
  <<UK1>> = UNIQUE (meeting_id, item_id, kind, model);  "= x" = DEFAULT x
  All 15 tables are STRICT (v2 adds integrity_flags, migration 0002). INTEGER timestamps = Unix ms (transcript start_time/end_time = ms from meeting start).
  Enums are stored as snake_case TEXT; list columns (parts, segment_ids, followups, entities, summary lists) are JSON TEXT.
  embeddings.vector is the only BLOB (little-endian f32 x dims). No raw audio and no screenshots are stored.
  meeting_summaries.meeting_id is both PK and FK, so a meeting has at most one summary (0..1).
  The only declared foreign keys are the 12 meeting_id ones drawn here (all ON DELETE CASCADE); other id columns are not enforced (see er-03).
  integrity_flags: one row per checked candidate answer (interviewer mode, check turned on); a re-check
  replaces the row (revision grows). signals and elevated are JSON; no audio, frames or gaze samples are stored.
  Schema version is tracked with PRAGMA user_version (SCHEMA_VERSION = 2), not with a table.
endlegend
@enduml
