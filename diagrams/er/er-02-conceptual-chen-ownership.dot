// Derived from: crates/openmeet-store/migrations/0001_initial.sql and 0002_integrity_flags.sql (primary keys, UNIQUE, and every
// "meeting_id ... REFERENCES meetings (id) ON DELETE CASCADE" clause) and the comments in it
// ("Not meeting data: kept by delete_all_meeting_data and retention").
// Chen notation: rectangle = entity (double = weak entity), diamond = relationship (double = identifying),
// ellipse = key attribute (underlined; dashed = partial key or alternate key), double line = total participation.
// The id references that have no FOREIGN KEY clause are in er-03-conceptual-chen-references.dot.
graph ER {
  graph [fontname="Segoe UI", rankdir=LR, nodesep=0.18, ranksep=0.7, pad=0.3, bgcolor="#FFFFFF",
         label=<<B>OpenMeet storage - conceptual ER, meeting ownership (Chen notation)</B>>, labelloc=t, fontsize=18];
  node  [fontname="Segoe UI", fontsize=12, color="#4F5BD5", fontcolor="#1F2430", style=filled, fillcolor="#F6F7FD"];
  edge  [fontname="Segoe UI", fontsize=11, color="#3E4756", fontcolor="#3E4756"];

  // ---------------- entities ----------------
  node [shape=box, penwidth=1.4, fillcolor="#E6E9FB", width=1.9];
  meetings [label="meetings", height=0.6, fontsize=14];
  transcript_segments; questions; answers; ai_suggestions; claims;
  screen_observations; action_items; embeddings; integrity_flags;
  node [peripheries=2];
  participants; topics; meeting_summaries;
  node [peripheries=1];

  // ---------------- relationships: one per declared FOREIGN KEY ----------------
  node [shape=diamond, fillcolor="#FFF8E1", color="#C9A227", fontsize=10, width=0.9, height=0.5, margin=0.02, penwidth=1];
  r_part [label="owns", peripheries=2];
  r_top  [label="owns", peripheries=2];
  r_sum  [label="owns", peripheries=2];
  r_seg [label="owns"]; r_q [label="owns"]; r_a [label="owns"]; r_s [label="owns"];
  r_c [label="owns"]; r_o [label="owns"]; r_ai [label="owns"]; r_e [label="owns"]; r_if [label="owns"];

  // ---------------- key attributes ----------------
  node [shape=ellipse, fillcolor="#F6F7FD", color="#4F5BD5", fontsize=11, width=0, height=0, margin="0.08,0.03"];
  k_meet  [label=<<U>id</U>>];
  k_part  [label=<position (partial key)>, style="filled,dashed"];
  k_top   [label=<position (partial key)>, style="filled,dashed"];
  k_sum   [label=<<U>meeting_id</U> (= owner key)>];
  k_seg   [label=<<U>id</U>>];
  k_q     [label=<<U>id</U>>];
  k_a     [label=<<U>id</U>>];
  k_s     [label=<<U>id</U>>];
  k_c     [label=<<U>id</U>>];
  k_o     [label=<<U>id</U>>];
  k_ai    [label=<<U>id</U>>];
  k_e     [label=<<U>id</U> (INTEGER)>];
  k_eu    [label=<UNIQUE (meeting_id, item_id, kind, model)>, style="filled,dashed"];
  k_if    [label=<<U>id</U>>];

  meetings -- k_meet;

  // meeting side: partial participation (a meeting may own no rows), cardinality 1
  meetings -- r_part [headlabel="1", labeldistance=2.2];
  meetings -- r_top  [headlabel="1", labeldistance=2.2];
  meetings -- r_sum  [headlabel="1", labeldistance=2.2];
  meetings -- r_seg  [headlabel="1", labeldistance=2.2];
  meetings -- r_q    [headlabel="1", labeldistance=2.2];
  meetings -- r_a    [headlabel="1", labeldistance=2.2];
  meetings -- r_s    [headlabel="1", labeldistance=2.2];
  meetings -- r_c    [headlabel="1", labeldistance=2.2];
  meetings -- r_o    [headlabel="1", labeldistance=2.2];
  meetings -- r_ai   [headlabel="1", labeldistance=2.2];
  meetings -- r_e    [headlabel="1", labeldistance=2.2];
  meetings -- r_if   [headlabel="1", labeldistance=2.2];

  // owned side: total participation (meeting_id NOT NULL), double line
  edge [color="#3E4756:invis:#3E4756", penwidth=1.1];
  r_part -- participants        [label="N"];
  r_top  -- topics              [label="N"];
  r_sum  -- meeting_summaries   [label="0..1"];
  r_seg  -- transcript_segments [label="N"];
  r_q    -- questions           [label="N"];
  r_a    -- answers             [label="N"];
  r_s    -- ai_suggestions      [label="N"];
  r_c    -- claims              [label="N"];
  r_o    -- screen_observations [label="N"];
  r_ai   -- action_items        [label="N"];
  r_e    -- embeddings          [label="N"];
  r_if   -- integrity_flags     [label="N"];
  edge [color="#3E4756", penwidth=1];

  participants -- k_part; topics -- k_top; meeting_summaries -- k_sum;
  transcript_segments -- k_seg; questions -- k_q; answers -- k_a; ai_suggestions -- k_s;
  claims -- k_c; screen_observations -- k_o; action_items -- k_ai;
  embeddings -- k_e; embeddings -- k_eu; integrity_flags -- k_if;

  // ---------------- not meeting data ----------------
  subgraph cluster_standalone {
    label=<Not meeting data: kept by delete_all_meeting_data and retention>; fontsize=11;
    style="rounded,filled"; fillcolor="#FBFBFD"; color="#8A93B5";
    node [shape=box, penwidth=1.4, fillcolor="#E6E9FB", width=1.9, style=filled, color="#4F5BD5"];
    privacy_rules; settings;
    node [shape=ellipse, fillcolor="#F6F7FD", penwidth=1, width=0, height=0];
    k_pr  [label=<<U>id</U>>];
    k_set [label=<<U>name</U> ('app')>];
    privacy_rules -- k_pr; settings -- k_set;
  }

  legend [shape=note, style=filled, fillcolor="#FFF8E1", color="#C9A227", fontsize=11, label=<
    <B>Reading the diagram</B><BR ALIGN="LEFT"/>
    Each "owns" diamond is one declared FOREIGN KEY<BR ALIGN="LEFT"/>
    meeting_id REFERENCES meetings (id) ON DELETE CASCADE (12 in total):<BR ALIGN="LEFT"/>
    deleting a meeting deletes every row it owns.<BR ALIGN="LEFT"/>
    Double line = total participation (meeting_id is NOT NULL).<BR ALIGN="LEFT"/>
    Weak entities (double rectangle, identifying double diamond):<BR ALIGN="LEFT"/>
    participants and topics have PRIMARY KEY (meeting_id, position);<BR ALIGN="LEFT"/>
    meeting_summaries has PRIMARY KEY meeting_id, so at most one per meeting.<BR ALIGN="LEFT"/>
    The settings row used by the store is name = 'app' (JSON settings document).<BR ALIGN="LEFT"/>
  >];
  { rank=same; meetings; legend; }
  legend -- meetings [style=invis];
}
