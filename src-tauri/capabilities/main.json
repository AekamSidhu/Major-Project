{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings, onboarding, history and diagnostics window: full access to app commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-write-text",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reset-settings",
    "allow-get-api-key-status",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-test-provider",
    "allow-list-models",
    "allow-get-data-flow",
    "allow-get-local-ai-status",
    "allow-start-local-ai",
    "allow-stop-local-ai",
    "allow-list-audio-devices",
    "allow-start-audio-test",
    "allow-stop-audio-test",
    "allow-list-screen-sources",
    "allow-set-screen-capture",
    "allow-capture-screen-now",
    "allow-get-snapshot",
    "allow-start-meeting",
    "allow-pause-meeting",
    "allow-resume-meeting",
    "allow-toggle-pause",
    "allow-stop-meeting",
    "allow-emergency-stop",
    "allow-detect-meeting-apps",
    "allow-focus-meeting-app",
    "allow-generate-answer",
    "allow-generate-followups",
    "allow-ask-openmeet",
    "allow-clarify-question",
    "allow-refine-answer",
    "allow-cancel-request",
    "allow-dismiss-suggestion",
    "allow-pin-suggestion",
    "allow-set-mode",
    "allow-set-answer-style",
    "allow-overlay-show",
    "allow-overlay-hide",
    "allow-overlay-toggle",
    "allow-set-click-through",
    "allow-overlay-set-size",
    "allow-overlay-set-position",
    "allow-overlay-save-position",
    "allow-overlay-move-to-display",
    "allow-overlay-begin-input",
    "allow-overlay-end-input",
    "allow-list-displays",
    "allow-report-render-latency",
    "allow-open-main-window",
    "allow-get-capture-privacy-status",
    "allow-set-capture-exclusion",
    "allow-list-privacy-rules",
    "allow-add-privacy-rule",
    "allow-remove-privacy-rule",
    "allow-suggested-privacy-apps",
    "allow-list-meetings",
    "allow-get-meeting",
    "allow-delete-meeting",
    "allow-delete-all-data",
    "allow-export-meeting",
    "allow-regenerate-summary",
    "allow-get-shortcut-status",
    "allow-update-shortcut",
    "allow-reset-shortcuts",
    "allow-get-diagnostics",
    "allow-run-benchmark",
    "allow-list-demo-scenarios",
    "allow-start-demo",
    "allow-stop-demo",
    "allow-simulate",
    "allow-clear-simulation"
  ]
}
