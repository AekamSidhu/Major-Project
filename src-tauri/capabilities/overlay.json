{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-window",
  "description": "Always-on-top meeting overlay: only live-assistant and overlay commands.",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-get-snapshot",
    "allow-generate-answer",
    "allow-generate-followups",
    "allow-ask-openmeet",
    "allow-clarify-question",
    "allow-refine-answer",
    "allow-cancel-request",
    "allow-dismiss-suggestion",
    "allow-pin-suggestion",
    "allow-set-mode",
    "allow-set-answer-style",
    "allow-overlay-show",
    "allow-overlay-hide",
    "allow-overlay-toggle",
    "allow-set-click-through",
    "allow-overlay-set-size",
    "allow-overlay-set-position",
    "allow-overlay-save-position",
    "allow-overlay-move-to-display",
    "allow-overlay-begin-input",
    "allow-overlay-end-input",
    "allow-list-displays",
    "allow-report-render-latency",
    "allow-open-main-window",
    "allow-pause-meeting",
    "allow-resume-meeting",
    "allow-toggle-pause",
    "allow-stop-meeting",
    "allow-emergency-stop",
    "allow-capture-screen-now",
    "allow-get-capture-privacy-status"
  ]
}
